# Delay-only diagnostic (Path B server egress h2-eth1).
# Static fig7 topology keeps loss at 0.001%; only delay steps here.
#
# Use with:
#   --scenario fig7
#   --dynamic-delay-profile scripts/mininet/delay_profile.pathB_200s.env
#
# Profile format (tc_delay_steps.sh):
#   IFACE=<iface>
#   <at_sec> <delay_ms>
IFACE=h2-eth1

0 20
90 80
100 20
