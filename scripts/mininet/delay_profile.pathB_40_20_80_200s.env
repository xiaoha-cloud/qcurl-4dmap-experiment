# Delay-only formal profile (Path B server egress h2-eth1).
# Static delay_formal topology:
#   Path A: 20 Mbps, 40 ms, 0%
#   Path B: 20 Mbps, 40 ms, 0%
# Dynamic Path B delay steps: 40 -> 20 -> 80 ms.
#
# Use with:
#   --scenario delay_formal
#   --dynamic-delay-profile scripts/mininet/delay_profile.pathB_40_20_80_200s.env
#
# Profile format (tc_delay_steps.sh):
#   IFACE=<iface>
#   <at_sec> <delay_ms>
IFACE=h2-eth1

0 40
90 20
110 80
