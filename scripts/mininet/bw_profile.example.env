# Link 1 (Path A) on h1: 10.0.1.x / h1-eth0.
# Link 2 (Path B) remains static in scenario config.
IFACE=h1-eth0

# Steps: absolute seconds from when tc_bw_steps.sh starts, bandwidth in Mbit/s.
# ACCeSS-T style capacity change test (300s run):
#   0-100s:  20 Mbps
#   100-200s: 30 Mbps
#   200-300s: 10 Mbps
0 20
100 30
200 10
