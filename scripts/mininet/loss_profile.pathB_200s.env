# Loss-only diagnostic (Path B server egress h2-eth1).
# Static fig7 topology keeps delay at 20ms; only loss steps here.
#
# Use with:
#   --scenario fig7
#   --dynamic-loss-profile scripts/mininet/loss_profile.pathB_200s.env
#
# Profile format (tc_loss_steps.sh):
#   IFACE=<iface>
#   <at_sec> <loss_pct>
IFACE=h2-eth1

0 0
90 0.05
100 0
