# Loss-only diagnostic (Path B server egress h2-eth1).
# Static fig7 topology is clean in this branch; only Path B loss steps here.
# Real impairment window: 90-110s, loss=0.45%.
#
# Use with:
#   --scenario fig7
#   --dynamic-loss-profile scripts/mininet/loss_profile.pathB_90_0p45_110_200s.env
#
# Profile format (tc_loss_steps.sh):
#   IFACE=<iface>
#   <at_sec> <loss_pct>
IFACE=h2-eth1

0 0
90 0.45
110 0
