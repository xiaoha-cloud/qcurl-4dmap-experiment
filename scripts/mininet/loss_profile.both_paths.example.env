# Scheme A: apply the same netem loss (and fixed delay) on BOTH client uplinks so
# multipath QUIC cannot evade loss by shifting traffic to the other path.
# Mutually exclusive with IFACE= — use IFACES= only.
IFACES=h1-eth0,h1-eth1

FIXED_DELAY_MS=20

# Steps: absolute seconds from when tc_loss_steps.sh starts, loss percent on each IFACES dev.
0 0.5
25 3
50 8
