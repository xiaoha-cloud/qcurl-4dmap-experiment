# Path B on h1 (10.0.2.x / h1-eth1). Path A is h1-eth0.
# For loss on both links, use IFACES=h1-eth0,h1-eth1 (see loss_profile.both_paths.example.env).
IFACE=h1-eth1

# Keep delay fixed so the dominant change is loss (paper-style separation).
FIXED_DELAY_MS=20

# Steps: absolute seconds from when tc_loss_steps.sh starts, loss percent on IFACE.
# Sort by time ascending. Only one mode per run: use --dynamic-loss-profile (not delay).
0 0.5
25 3
50 8
