# Short-video variant for T-mode capacity change response.
# Use when media ends early (e.g. before 100s) so all three steps still run.
# Link 1 (Path A) changes capacity; Link 2 stays static in scenario config.
IFACE=h1-eth0

# Steps: absolute seconds from tc_bw_steps.sh start, bandwidth in Mbit/s.
# 0-40s:  20 Mbps
# 40-80s: 30 Mbps
# 80s+:   10 Mbps
0 20
40 30
80 10
