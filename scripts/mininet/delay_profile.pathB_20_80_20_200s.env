# Delay-only diagnostic (Path B server egress h2-eth1).
# Static delay_formal topology starts both paths at 20 Mbps, 40ms, 0%.
# Step 0 immediately sets only Path B to 20ms; Path A stays at the scenario value.
#
# Use with:
#   --scenario delay_formal
#   --dynamic-delay-profile scripts/mininet/delay_profile.pathB_20_80_20_200s.env
#
# Profile format (tc_delay_steps.sh):
#   IFACE=<iface>
#   <at_sec> <delay_ms>
IFACE=h2-eth1

0 20
90 80
110 20
